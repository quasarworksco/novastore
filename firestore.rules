rules_version = '2';

// Reglas de la tienda NovaStore.
// Nota: acceso abierto para simplificar la operación con la API key
// pública. Para endurecer en producción se recomienda Firebase Auth
// con un custom claim de admin sobre las escrituras.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de productos: lectura pública, escritura desde el panel.
    match /productos/{producto} {
      allow read: if true;
      allow write: if true;
    }

    // Ventas (pedidos online y ventas manuales). El borrado se hace
    // desde el panel con confirmación.
    match /ventas/{venta} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Clientes: se crean/actualizan automáticamente con cada venta.
    // Eliminar y unir duplicados se hace desde el panel.
    match /clientes/{cliente} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Configuración de la tienda (tasa de cambio Bs/USD).
    match /config/{documento} {
      allow read: if true;
      allow write: if true;
    }

    // Gastos del negocio (panel administrativo).
    match /gastos/{gasto} {
      allow read: if true;
      allow write: if true;
    }
  }
}
