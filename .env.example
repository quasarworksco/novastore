# Todas las variables son NEXT_PUBLIC_* (se embeben en el build estático).
# Los valores por defecto ya están integrados en el código; define estas
# variables solo para sobreescribirlos al compilar.

# ── Firebase (Firestore) ─────────────────────────────────────────────
# Proyecto "novastore-c5457" configurado por defecto en src/lib/firebase.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyACC84cNCP09Qb45Fkn5YNFKKP3xBskk6I
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=novastore-c5457.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=novastore-c5457
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=novastore-c5457.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=262230357419
NEXT_PUBLIC_FIREBASE_APP_ID=1:262230357419:web:dcdb2065c2ebb2f9940eee

# ── Cloudinary (carga de imágenes de productos) ──────────────────────
# El preset debe ser de tipo "unsigned" en Cloudinary → Settings → Upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=gingt9vy
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=novastore

# ── Panel administrativo (/admin) ────────────────────────────────────
# SHA-256 de "usuario:contraseña". Por defecto: admin / novastore2026.
# Genera el tuyo con:
#   node -e "console.log(require('crypto').createHash('sha256').update('usuario:contraseña').digest('hex'))"
NEXT_PUBLIC_ADMIN_HASH=

# ── WhatsApp (checkout) ──────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=584121002090
