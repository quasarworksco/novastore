# ── Firebase (Firestore) ─────────────────────────────────────────────
# Si estas variables no están definidas, la tienda arranca en "modo demo"
# con datos de ejemplo persistidos en localStorage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Cloudinary (carga de imágenes de productos) ──────────────────────
# Configurado por defecto en el código (src/lib/cloudinary.ts).
# El preset debe ser de tipo "unsigned" en Cloudinary → Settings → Upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=gingt9vy
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=novastore

# ── Panel administrativo (/admin) ────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=novastore2026
ADMIN_SECRET=cambia-esta-clave-secreta

# ── WhatsApp (checkout) ──────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=584121002090
